# Exemplo de variáveis de ambiente para o projeto App Front - Metas Financeiras

# URL base da API (usada no frontend para Axios)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Segredo para geração e validação do JWT (NUNCA suba o valor real para o GitHub)
JWT_SECRET=sua_chave_secreta_super_segura

# (Opcional) URL do banco de dados para o Prisma (SQLite por padrão)
DATABASE_URL="file:./dev.db"